# ============================================================================
# LR Time - .env.production (beta)
#
# Copier en .env.production sur le VPS puis remplir les ??? avant `docker compose up`.
# Toute valeur marquee GENERATE doit etre generee localement (voir DEPLOY_BETA.md).
# ============================================================================

# ---- Domaine et hotes -----------------------------------------------------
# Domaine principal de la beta (ex: app.lrtime.com)
DOMAIN=???.lrtime.com
ALLOWED_HOSTS=???.lrtime.com,www.???.lrtime.com

# URL publique de l'API utilisee par le frontend Next.js (https obligatoire)
NEXT_PUBLIC_API_BASE_URL=https://???.lrtime.com
NEXT_PUBLIC_EMPLOYEE_API_BASE_URL=https://???.lrtime.com

# CORS : autorise le front a appeler l'API
CORS_ALLOWED_ORIGINS=https://???.lrtime.com
FRONTEND_AUTH_BASE_URL=https://???.lrtime.com

# Email de contact pour Let's Encrypt
CERTBOT_EMAIL=roland@label-ci.com

# ---- Base de donnees Postgres --------------------------------------------
POSTGRES_DB=lrtime
POSTGRES_USER=lrtime
# GENERATE: openssl rand -base64 32
POSTGRES_PASSWORD=???

# ---- Django ---------------------------------------------------------------
# GENERATE: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=???

# GENERATE: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KMS_KEY=???

LANGUAGE_CODE=fr
LOG_LEVEL=INFO

JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# ---- Email (SMTP label-ci.com) -------------------------------------------
# mail.label-ci.com utilise SMTP implicite SSL sur le port 465.
# Ne pas activer EMAIL_USE_TLS avec ce port.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.label-ci.com
EMAIL_PORT=465
EMAIL_HOST_USER=noreply@label-ci.com
EMAIL_HOST_PASSWORD=???
EMAIL_USE_TLS=false
EMAIL_USE_SSL=true
DEFAULT_FROM_EMAIL=noreply@label-ci.com

# ---- Hikvision Device Gateway --------------------------------------------
# Si tu n'as pas encore de gateway accessible publiquement, mets une IP factice.
# Les beta-testeurs onboarderont leur propre gateway via le wizard.
HIK_DEVICE_GATEWAY_BASE_URL=http://??.??.??.??:88
HIK_DEVICE_GATEWAY_USERNAME=admin
HIK_DEVICE_GATEWAY_PASSWORD=???
# Token HMAC pour valider les webhooks Hikvision
HIK_GATEWAY_WEBHOOK_TOKEN=???
# Liste d'IPs autorisees a pousser des webhooks (separees par virgule)
HIK_GATEWAY_ALLOWED_IPS=

# ---- Observabilite (optionnel) -------------------------------------------
SENTRY_DSN=

# ---- Beta mode -----------------------------------------------------------
# 1 = signup ouvert, Stripe desactive, banniere "Beta gratuite" affichee
BETA_MODE=1
