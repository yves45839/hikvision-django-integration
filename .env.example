# Django settings
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=127.0.0.1,localhost
LANGUAGE_CODE=fr

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Static files
STATIC_ROOT=staticfiles

# CORS and frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_AUTH_BASE_URL=http://localhost:3000

# Email configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=no-reply@example.com

# Hikvision Device Gateway
HIK_DEVICE_GATEWAY_BASE_URL=http://gateway-ip:88
HIK_DEVICE_GATEWAY_USERNAME=admin
HIK_DEVICE_GATEWAY_PASSWORD=change_me
HIK_DEVICE_GATEWAY_EHOME_KEY=change_me
HIK_GATEWAY_WEBHOOK_TOKEN=your-webhook-token
HIK_GATEWAY_ALLOWED_IPS=192.168.1.100,192.168.1.101
HIK_WEBHOOK_IP=0.0.0.0
HIK_WEBHOOK_PORT=443
HIK_WEBHOOK_URL=/api/hik/events
HIK_EVENTS_AUTO_CATCHUP_THROTTLE_SECONDS=2
HIK_CATCHUP_LOOKBACK_HOURS=24
HIK_CATCHUP_FAST_ACTIVE_HOURS=48

# Security and encryption
KMS_KEY=your-base64-encoded-fernet-key
SECURE_HSTS_SECONDS=31536000
SECURE_SSL_REDIRECT=1

# JWT configuration
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# Payment webhook
PAYMENT_WEBHOOK_TOKEN=your-payment-webhook-token

# --- Stripe (billing) ---
# Get these from https://dashboard.stripe.com/test/apikeys (test mode)
# Use sk_live_... and pk_live_... in production.
STRIPE_SECRET_KEY=sk_test_xxx_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_xxx_replace_me
# Generated by `stripe listen --forward-to localhost:8000/api/billing/webhook/`
# or by adding a webhook endpoint in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=whsec_xxx_replace_me
# Pin a Stripe API version so response shapes don't drift on us.
STRIPE_API_VERSION=2024-06-20

# SQLite options (for development)
SQLITE_TIMEOUT_SECONDS=20
SQLITE_JOURNAL_MODE=WAL
SQLITE_SYNCHRONOUS=NORMAL

# Language cookie
LANGUAGE_COOKIE_NAME=securepoint_language
LANGUAGE_COOKIE_AGE=31536000

# Logging
LOG_LEVEL=INFO

# Sentry (optional, DSN not required for local development)
SENTRY_DSN=
