{
  "info": {
    "_postman_id": "9e8dc260-06a4-4a38-9a84-9dc4f676f63a",
    "name": "Employees - Create And Modify",
    "description": "Collection Postman pour l'ajout et la modification des personnes (POST/PATCH /api/employees/). Inclut auth JWT, creation, import depuis device et edition.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('baseUrl')) { pm.collectionVariables.set('baseUrl', 'http://localhost:8000'); }",
          "if ((pm.collectionVariables.get('employeeNoAuto') || '1') === '1') {",
          "  var prefix = pm.collectionVariables.get('employeeNoPrefix') || 'PERS';",
          "  var suffix = String(Date.now()).slice(-8);",
          "  pm.collectionVariables.set('employeeNo', prefix + suffix);",
          "}"
        ]
      }
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "username",
      "value": "emp-admin"
    },
    {
      "key": "password",
      "value": "pass"
    },
    {
      "key": "tenantId",
      "value": "1"
    },
    {
      "key": "departmentId",
      "value": "1"
    },
    {
      "key": "deviceId",
      "value": "5"
    },
    {
      "key": "employeeNo",
      "value": "PERS0008"
    },
    {
      "key": "employeeNoPrefix",
      "value": "PERS"
    },
    {
      "key": "employeeNoAuto",
      "value": "1"
    },
    {
      "key": "employeeId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth - Get JWT Token",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/token/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "token",
            ""
          ]
        },
        "description": "Récupère access/refresh token JWT."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "pm.collectionVariables.set('accessToken', json.access || '');",
              "pm.collectionVariables.set('refreshToken', json.refresh || '');"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Person - Full Payload",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tenant\": {{tenantId}},\n  \"department\": {{departmentId}},\n  \"devices\": [{{deviceId}}],\n  \"employee_no\": \"{{employeeNo}}\",\n  \"name\": \"Awa Traore\",\n  \"first_name\": \"Awa\",\n  \"last_name\": \"Traore\",\n  \"gender\": \"female\",\n  \"email\": \"awa.traore@company.com\",\n  \"phone\": \"+2250102030405\",\n  \"valid_from\": \"2026-03-10T08:00:00\",\n  \"valid_to\": \"2027-03-10T08:00:00\",\n  \"remark\": \"Employée permanente\",\n  \"access_group\": \"STAFF\",\n  \"pin_code\": \"2580\",\n  \"is_super_user\": false,\n  \"extended_door_open_time\": 10,\n  \"is_blocklisted\": false,\n  \"is_visitor\": false,\n  \"is_device_operator\": false,\n  \"custom_profile\": \"standard-day\",\n  \"only_authenticate\": false,\n  \"date_of_birth\": \"1994-11-19\",\n  \"identity_type\": \"National ID\",\n  \"identity_no\": \"CI-ABJ-998877\",\n  \"position\": \"HR Manager\",\n  \"hire_date\": \"2022-01-05\",\n  \"address\": \"Abidjan, Cocody\",\n  \"attributes\": [\n    { \"name\": \"user_type\", \"value\": \"normal\" }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/employees/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "employees",
            ""
          ]
        },
        "description": "Création préremplie compatible terminal (ajout personne + push auto sur device lié)."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201/207', function () { pm.expect([201, 207]).to.include(pm.response.code); });",
              "var json = pm.response.json();",
              "pm.collectionVariables.set('employeeId', json.id || '');",
              "pm.test('employee created', function () { pm.expect(json.id).to.be.a('number'); });",
              "pm.test('gateway push block exists', function () { pm.expect(json.gateway_push).to.exist; });"
            ]
          }
        }
      ]
    },
    {
      "name": "Import Persons - From Device",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tenant\": {{tenantId}},\n  \"device_id\": {{deviceId}},\n  \"max_results\": 100,\n  \"link_device\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/employees/import-from-gateway/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "employees",
            "import-from-gateway",
            ""
          ]
        },
        "description": "Importe depuis le terminal les personnes déjà présentes et fait un upsert local."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200/207', function () { pm.expect([200, 207]).to.include(pm.response.code); });",
              "var json = pm.response.json();",
              "pm.test('imported_count exists', function () { pm.expect(json.imported_count).to.be.a('number'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Modify Person - PATCH",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 999999,\n  \"name\": \"Awa Traore Modifiee\",\n  \"phone\": \"+2250708091011\",\n  \"remark\": \"Mise a jour via Postman\",\n  \"is_active\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/employees/{{employeeId}}/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "employees",
            "{{employeeId}}",
            ""
          ]
        },
        "description": "Modifie une personne existante. Le champ name est modifiable. Le champ id est ignore par l'API."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "pm.test('name updated', function () { pm.expect(json.name).to.eql('Awa Traore Modifiee'); });",
              "pm.test('phone updated', function () { pm.expect(json.phone).to.eql('+2250708091011'); });"
            ]
          }
        }
      ]
    }
  ]
}
