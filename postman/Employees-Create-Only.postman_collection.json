{
  "info": {
    "_postman_id": "9e8dc260-06a4-4a38-9a84-9dc4f676f63a",
    "name": "Employees - Create Person Only",
    "description": "Collection Postman dédiée uniquement à l'ajout des personnes (POST /api/employees/). Inclut auth JWT, payload minimal, payload complet, multi-cartes, multi-empreintes et cas d'erreurs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('baseUrl')) { pm.collectionVariables.set('baseUrl', 'http://localhost:8000'); }"
        ]
      }
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "username", "value": "emp-admin" },
    { "key": "password", "value": "pass" },
    { "key": "tenantId", "value": "1" },
    { "key": "departmentId", "value": "1" },
    { "key": "deviceId", "value": "1" }
  ],
  "item": [
    {
      "name": "Auth - Get JWT Token",
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/token/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "token", ""]
        },
        "description": "Récupère access/refresh token JWT."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "pm.collectionVariables.set('accessToken', json.access || '');",
              "pm.collectionVariables.set('refreshToken', json.refresh || '');"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Person - Minimal Required",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tenant\": {{tenantId}},\n  \"employee_no\": \"PERS-0001\",\n  \"name\": \"Jean Kouassi\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/employees/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "employees", ""]
        },
        "description": "Création minimale avec les 2 champs obligatoires: Person ID (employee_no) + Name."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
              "var json = pm.response.json();",
              "pm.test('employee_no is returned', function () { pm.expect(json.employee_no).to.eql('PERS-0001'); });",
              "pm.test('name is returned', function () { pm.expect(json.name).to.eql('Jean Kouassi'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Person - Full Payload",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tenant\": {{tenantId}},\n  \"department\": {{departmentId}},\n  \"devices\": [{{deviceId}}],\n  \"employee_no\": \"PERS-0002\",\n  \"name\": \"Awa Traore\",\n  \"first_name\": \"Awa\",\n  \"last_name\": \"Traore\",\n  \"gender\": \"female\",\n  \"email\": \"awa.traore@company.com\",\n  \"phone\": \"+2250102030405\",\n  \"valid_from\": \"2026-03-10T08:00:00Z\",\n  \"valid_to\": \"2027-03-10T08:00:00Z\",\n  \"remark\": \"Employée permanente\",\n  \"cards\": [\n    { \"card_no\": \"CARD-10001\", \"card_type\": \"normalCard\" },\n    { \"card_no\": \"CARD-10002\", \"card_type\": \"normalCard\" }\n  ],\n  \"fingerprints\": [\n    { \"finger_index\": 1, \"template\": \"fp-template-1\" },\n    { \"finger_index\": 2, \"template\": \"fp-template-2\" }\n  ],\n  \"face\": { \"face_data\": \"base64-face-template\" },\n  \"access_group\": \"STAFF\",\n  \"pin_code\": \"2580\",\n  \"is_super_user\": false,\n  \"extended_door_open_time\": 10,\n  \"is_blocklisted\": false,\n  \"is_visitor\": false,\n  \"is_device_operator\": false,\n  \"custom_profile\": \"standard-day\",\n  \"only_authenticate\": false,\n  \"date_of_birth\": \"1994-11-19\",\n  \"identity_type\": \"National ID\",\n  \"identity_no\": \"CI-ABJ-998877\",\n  \"position\": \"HR Manager\",\n  \"hire_date\": \"2022-01-05\",\n  \"address\": \"Abidjan, Cocody\",\n  \"attributes\": [\n    { \"name\": \"user_type\", \"value\": \"normal\" }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/employees/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "employees", ""]
        },
        "description": "Création complète avec Basic Information, Credential, Access Control, Extension Information."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
              "var json = pm.response.json();",
              "pm.test('cards created', function () { pm.expect((json.cards || []).length).to.eql(2); });",
              "pm.test('fingerprints created', function () { pm.expect((json.fingerprints || []).length).to.eql(2); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Person - Require Credential But Missing",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tenant\": {{tenantId}},\n  \"employee_no\": \"PERS-0003\",\n  \"name\": \"No Credential User\",\n  \"require_credential\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/employees/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "employees", ""]
        },
        "description": "Doit retourner 400 si aucun moyen d'authentification n'est fourni alors que require_credential=true."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 400', function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Person - Error Missing Name",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tenant\": {{tenantId}},\n  \"employee_no\": \"PERS-0004\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/employees/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "employees", ""]
        },
        "description": "Doit retourner 400 car Name est obligatoire."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 400', function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Person - Error More Than 10 Fingerprints",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tenant\": {{tenantId}},\n  \"employee_no\": \"PERS-0005\",\n  \"name\": \"Too Many Prints\",\n  \"fingerprints\": [\n    { \"finger_index\": 1, \"template\": \"fp-1\" },\n    { \"finger_index\": 2, \"template\": \"fp-2\" },\n    { \"finger_index\": 3, \"template\": \"fp-3\" },\n    { \"finger_index\": 4, \"template\": \"fp-4\" },\n    { \"finger_index\": 5, \"template\": \"fp-5\" },\n    { \"finger_index\": 6, \"template\": \"fp-6\" },\n    { \"finger_index\": 7, \"template\": \"fp-7\" },\n    { \"finger_index\": 8, \"template\": \"fp-8\" },\n    { \"finger_index\": 9, \"template\": \"fp-9\" },\n    { \"finger_index\": 10, \"template\": \"fp-10\" },\n    { \"finger_index\": 1, \"template\": \"fp-11\" }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/employees/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "employees", ""]
        },
        "description": "Doit retourner 400: maximum 10 empreintes + index unique."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 400', function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    }
  ]
}
